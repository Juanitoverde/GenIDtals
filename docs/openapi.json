  "components": {
    "schemas": {
      "EnrollRequest": {
        "properties": {
          "images": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 16,
            "minItems": 1,
            "title": "Images",
            "description": "Base64-encoded reference images (PNG, JPEG, ...)"
          },
          "overwrite": {
            "type": "boolean",
            "title": "Overwrite",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "images"
        ],
        "title": "EnrollRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "QualityRequest": {
        "properties": {
          "image": {
            "type": "string",
            "title": "Image"
          }
        },
        "type": "object",
        "required": [
          "image"
        ],
        "title": "QualityRequest"
      },
      "TemplateCreateRequest": {
        "properties": {
          "subject_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Subject Id"
          },
          "images": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 16,
            "minItems": 1,
            "title": "Images"
          }
        },
        "type": "object",
        "required": [
          "subject_id",
          "images"
        ],
        "title": "TemplateCreateRequest"
      },
      "TemplateResealRequest": {
        "properties": {
          "subject_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Subject Id"
          },
          "template": {
            "type": "string",
            "title": "Template"
          }
        },
        "type": "object",
        "required": [
          "subject_id",
          "template"
        ],
        "title": "TemplateResealRequest"
      },
      "TemplateVerifyRequest": {
        "properties": {
          "image": {
            "type": "string",
            "title": "Image",
            "description": "Base64-encoded capture"
          },
          "frames": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Frames",
            "description": "Optional extra burst frames for motion liveness"
          },
          "subject_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Subject Id"
          },
          "template": {
            "type": "string",
            "title": "Template",
            "description": "Base64 sealed template from POST /v1/templates"
          }
        },
        "type": "object",
        "required": [
          "image",
          "subject_id",
          "template"
        ],
        "title": "TemplateVerifyRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerifyRequest": {
        "properties": {
          "image": {
            "type": "string",
            "title": "Image",
            "description": "Base64-encoded capture"
          },
          "frames": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Frames",
            "description": "Optional extra burst frames for motion liveness"
          }
        },
        "type": "object",
        "required": [
          "image"
        ],
        "title": "VerifyRequest"
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
